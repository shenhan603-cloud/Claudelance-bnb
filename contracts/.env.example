# --- Sepolia (shared single-key OK) ----------------------------------------
DEPLOYER_PRIVATE_KEY=0x...
DEPLOYER_ADDRESS=0x...
CELO_SEPOLIA_RPC=https://forno.celo-sepolia.celo-testnet.org/
CUSD_SEPOLIA=

# For Sepolia broadcasts, set ALLOW_SHARED_ADMIN_WALLETS=true to let the deploy
# script accept identical deployer/owner/treasury/relayer addresses.

# --- Mainnet (chainid 42220 enforces distinct keys) -----------------------
CELO_MAINNET_RPC=https://forno.celo.org
CUSD_MAINNET=0x765DE816845861e75A25fCA122bb6898B8B1282a

MAINNET_DEPLOYER_PRIVATE_KEY=0x...
MAINNET_DEPLOYER_ADDRESS=0x...
MAINNET_OWNER_PRIVATE_KEY=0x...
MAINNET_OWNER_ADDRESS=0x...
MAINNET_TREASURY_PRIVATE_KEY=0x...
MAINNET_TREASURY_ADDRESS=0x...
MAINNET_RELAYER_PRIVATE_KEY=0x...
MAINNET_RELAYER_ADDRESS=0x...

# --- Verification ----------------------------------------------------------
# Unified Etherscan API V2 key — works for Celo + 60+ other EVM chains.
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Constructor args (override when broadcasting) ------------------------
# Deploy.s.sol reads these. For mainnet, set them to MAINNET_* equivalents.
TREASURY_ADDRESS=
CI_RELAYER_ADDRESS=
OWNER_ADDRESS=
CUSD_ADDRESS=

# --- BNB Chain (multichain expansion; Celo remains the production default) ---
# BSC Testnet (chainId 97) / BSC Mainnet (chainId 56). Explorer: testnet.bscscan.com / bscscan.com
# Faucet: https://www.bnbchain.org/en/testnet-faucet
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org
# Token slots on BSC (all 18 decimals). On mainnet DeployV3 defaults to the
# canonical addresses below if unset; on testnet deploy mocks first
# (DeployMocks.s.sol) and paste the addresses here.
#   mainnet USDT 0x55d398326f99059fF775485246999027B3197955
#   mainnet WBNB 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
#   mainnet USDC 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
USDT_ADDRESS=
WBNB_ADDRESS=
# ERC-8004 registries on BSC. The reference CREATE2 deployments were observed
# on-chain (eth_getCode) on 2026-09-24 - double-check before broadcasting:
#   BSC mainnet: identity 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432 / reputation 0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
#   BSC testnet: identity 0x8004A818BFB912233c491871b3d84c89A494BD9e / reputation 0x8004B663056A597Dffe9eCcC1965A193B7388713
# IDENTITY_REGISTRY_ADDRESS= / REPUTATION_REGISTRY_ADDRESS= (set per target chain)
